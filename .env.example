# ─────────────────────────────────────────────────────────────────────────────
#  Mirai — environment
#  Copy to `.env.local` and fill in. Everything here is optional: with no keys
#  at all the app still boots and runs in Rehearsal Mode (scripted replies,
#  browser speech synthesis, full Live2D pipeline).
# ─────────────────────────────────────────────────────────────────────────────

# Vercel AI Gateway — one key unlocks chat, speech and transcription.
# https://vercel.com/ai-gateway
AI_GATEWAY_API_KEY=

# Default model used when the client does not pick one.
# Any id from https://ai-gateway.vercel.sh/v1/models works.
MIRAI_DEFAULT_MODEL=anthropic/claude-sonnet-5

# Text-to-speech. Leave blank to use the browser's built-in SpeechSynthesis.
MIRAI_SPEECH_MODEL=openai/tts-1-hd
MIRAI_SPEECH_VOICE=nova

# Speech-to-text used by the mic button when the browser has no native
# SpeechRecognition (Firefox, Safari on some platforms).
MIRAI_TRANSCRIBE_MODEL=openai/whisper-1

# Simple in-memory abuse guard for the public routes.
MIRAI_RATE_LIMIT_REQUESTS=30
MIRAI_RATE_LIMIT_WINDOW_SECONDS=60

# Public site URL, used for Open Graph metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
